SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/freightflow
SPRING_DATASOURCE_USERNAME=freightflow
SPRING_DATASOURCE_PASSWORD=replace-with-local-db-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=20
# Generate once with: openssl rand -base64 32
MAIL_CREDENTIAL_ENCRYPTION_KEY=
# Only for isolated local mail-server testing; ignored outside the local profile.
MAIL_ALLOW_PRIVATE_HOSTS=false
# Mailbox email and password belong in Settings > Hostinger Email, not this file.
# Optional legacy Gmail OAuth and app-wide SMTP configuration remain supported in application.yml.
